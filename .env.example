# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_NAME=NewsPulse
APP_ENV=local            # local | staging | production
LOG_LEVEL=INFO

# --- Storage ---
# Local docker-compose default. On DigitalOcean, replace with the Managed
# Postgres connection string (include ?sslmode=require).
DATABASE_URL=postgresql+psycopg://newspulse:newspulse@db:5432/newspulse

# --- Object storage ---
# Local directory for raw article text during dev.
STORAGE_DIR=./data/raw

# DO Spaces (used in production from Phase 6; leave blank for now).
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# --- Mistral AI (used from Phase 2 for enrichment + synthesis) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Webhook / NewsAPI ingestion (Phase 9) ---
NEWSAPI_KEY=
WEBHOOK_SECRET=
REBUILD_AFTER_N=5
